#include <windows.h>
#include "../src/resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_APP ICON "QuickPad.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "QuickPad.manifest"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION 1,1,0,0
    PRODUCTVERSION 1,1,0,0
    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
    FILEFLAGS 0
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_APP
    FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "QuickPad"
            VALUE "FileVersion", "1.1.0"
            VALUE "InternalName", "QuickPad"
            VALUE "OriginalFilename", "QuickPad.exe"
            VALUE "ProductName", "QuickPad"
            VALUE "ProductVersion", "1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

/* Built before this script and found through the include path build.ps1 passes. */
IDR_SHELL_EXTENSION RCDATA "QuickPadShell.dll"

IDR_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",            IDM_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",        IDM_FILE_OPEN
        MENUITEM "&Reload from Disk",       IDM_FILE_RELOAD
        MENUITEM "&Save\tCtrl+S",           IDM_FILE_SAVE
        MENUITEM "Save &As...\tCtrl+Shift+S", IDM_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "Open Containing &Folder", IDM_FILE_OPEN_FOLDER
        MENUITEM "Copy Full &Path",         IDM_FILE_COPY_PATH
        MENUITEM SEPARATOR
        MENUITEM "&Close\tCtrl+W",          IDM_FILE_CLOSE
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",           IDM_EDIT_UNDO
        MENUITEM "&Redo\tCtrl+Y",           IDM_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",            IDM_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C",           IDM_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V",          IDM_EDIT_PASTE
        MENUITEM "De&lete\tDel",            IDM_EDIT_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&Find...\tCtrl+F",        IDM_EDIT_FIND
        MENUITEM "Find &Next\tF3",          IDM_EDIT_FIND_NEXT
        MENUITEM "Find Pre&vious\tShift+F3", IDM_EDIT_FIND_PREVIOUS
        MENUITEM "&Replace...\tCtrl+H",     IDM_EDIT_REPLACE
        MENUITEM "&Go To...\tCtrl+G",       IDM_EDIT_GOTO
        MENUITEM SEPARATOR
        MENUITEM "Select &All\tCtrl+A",     IDM_EDIT_SELECT_ALL
        MENUITEM "Time/&Date\tF5",          IDM_EDIT_TIME_DATE
        MENUITEM SEPARATOR
        MENUITEM "D&uplicate Line\tCtrl+D", IDM_EDIT_DUPLICATE_LINE
        MENUITEM "Delete L&ine\tCtrl+Shift+K", IDM_EDIT_DELETE_LINE
        MENUITEM "Move Line U&p\tAlt+Up",   IDM_EDIT_MOVE_LINE_UP
        MENUITEM "Move Line Do&wn\tAlt+Down", IDM_EDIT_MOVE_LINE_DOWN
        MENUITEM "&Join Lines\tCtrl+J",     IDM_EDIT_JOIN_LINES
        MENUITEM SEPARATOR
        MENUITEM "UPPER&CASE\tCtrl+Shift+U", IDM_EDIT_UPPERCASE
        MENUITEM "&lowercase\tCtrl+U",      IDM_EDIT_LOWERCASE
        MENUITEM "Trim Trailing &Whitespace", IDM_EDIT_TRIM_WHITESPACE
    END
    POPUP "F&ormat"
    BEGIN
        MENUITEM "&Word Wrap",              IDM_FORMAT_WORD_WRAP
        MENUITEM "&Auto Indent",            IDM_FORMAT_AUTO_INDENT
        MENUITEM "&Font...",                IDM_FORMAT_FONT
        MENUITEM SEPARATOR
        POPUP "&Tab Size"
        BEGIN
            MENUITEM "&2",                  IDM_FORMAT_TAB_2
            MENUITEM "&4",                  IDM_FORMAT_TAB_4
            MENUITEM "&8",                  IDM_FORMAT_TAB_8
        END
        POPUP "&Line Ending"
        BEGIN
            MENUITEM "&Windows (CRLF)",     IDM_FORMAT_CRLF
            MENUITEM "&Unix (LF)",          IDM_FORMAT_LF
            MENUITEM "&Macintosh (CR)",     IDM_FORMAT_CR
        END
        POPUP "&Encoding"
        BEGIN
            MENUITEM "UTF-&8",              IDM_FORMAT_UTF8
            MENUITEM "UTF-8 with &BOM",     IDM_FORMAT_UTF8_BOM
            MENUITEM "UTF-16 &LE",          IDM_FORMAT_UTF16LE
            MENUITEM "UTF-16 B&E",          IDM_FORMAT_UTF16BE
            MENUITEM "&ANSI",               IDM_FORMAT_ANSI
        END
    END
    POPUP "&View"
    BEGIN
        MENUITEM "Zoom &In\tCtrl+Plus",     IDM_VIEW_ZOOM_IN
        MENUITEM "Zoom &Out\tCtrl+Minus",   IDM_VIEW_ZOOM_OUT
        MENUITEM "&Restore Default Zoom\tCtrl+0", IDM_VIEW_ZOOM_RESET
        MENUITEM SEPARATOR
        MENUITEM "&Status Bar",             IDM_VIEW_STATUS_BAR
        MENUITEM "Always on &Top",          IDM_VIEW_ALWAYS_ON_TOP
        MENUITEM "&Full Screen\tF11",       IDM_VIEW_FULL_SCREEN
    END
    POPUP "&Settings"
    BEGIN
        MENUITEM "&Start with Windows",     IDM_START_WITH_WINDOWS
    END
END

IDD_POOL_SIZE DIALOGEX 0, 0, 236, 74
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Window Pool Size"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Editor windows kept drawn and ready to appear (0 to 100):", IDC_STATIC, 8, 9, 220, 10
    EDITTEXT        IDC_POOL_SIZE, 8, 24, 48, 14, ES_NUMBER
    DEFPUSHBUTTON   "OK", IDOK, 124, 52, 50, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 178, 52, 50, 15
END

IDD_GOTO DIALOGEX 0, 0, 180, 70
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Go To Line"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "&Line number:", IDC_STATIC, 8, 9, 164, 10
    EDITTEXT        IDC_GOTO_LINE, 8, 22, 164, 14, ES_NUMBER | ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Go To", IDOK, 68, 48, 50, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 122, 48, 50, 15
END

IDR_ACCELERATORS ACCELERATORS
BEGIN
    "N",    IDM_FILE_NEW,       VIRTKEY, CONTROL
    "O",    IDM_FILE_OPEN,      VIRTKEY, CONTROL
    "S",    IDM_FILE_SAVE,      VIRTKEY, CONTROL
    "S",    IDM_FILE_SAVE_AS,   VIRTKEY, CONTROL, SHIFT
    "W",    IDM_FILE_CLOSE,     VIRTKEY, CONTROL
    "F",    IDM_EDIT_FIND,      VIRTKEY, CONTROL
    VK_F3,  IDM_EDIT_FIND_NEXT, VIRTKEY
    VK_F3,  IDM_EDIT_FIND_PREVIOUS, VIRTKEY, SHIFT
    "H",    IDM_EDIT_REPLACE,   VIRTKEY, CONTROL
    "G",    IDM_EDIT_GOTO,      VIRTKEY, CONTROL
    VK_F5,  IDM_EDIT_TIME_DATE, VIRTKEY
    "D",    IDM_EDIT_DUPLICATE_LINE, VIRTKEY, CONTROL
    "K",    IDM_EDIT_DELETE_LINE, VIRTKEY, CONTROL, SHIFT
    VK_UP,  IDM_EDIT_MOVE_LINE_UP, VIRTKEY, ALT
    VK_DOWN, IDM_EDIT_MOVE_LINE_DOWN, VIRTKEY, ALT
    "J",    IDM_EDIT_JOIN_LINES, VIRTKEY, CONTROL
    "U",    IDM_EDIT_UPPERCASE, VIRTKEY, CONTROL, SHIFT
    "U",    IDM_EDIT_LOWERCASE, VIRTKEY, CONTROL
    VK_OEM_PLUS, IDM_VIEW_ZOOM_IN, VIRTKEY, CONTROL
    VK_ADD, IDM_VIEW_ZOOM_IN,   VIRTKEY, CONTROL
    VK_OEM_MINUS, IDM_VIEW_ZOOM_OUT, VIRTKEY, CONTROL
    VK_SUBTRACT, IDM_VIEW_ZOOM_OUT, VIRTKEY, CONTROL
    "0",    IDM_VIEW_ZOOM_RESET, VIRTKEY, CONTROL
    VK_NUMPAD0, IDM_VIEW_ZOOM_RESET, VIRTKEY, CONTROL
    VK_F11, IDM_VIEW_FULL_SCREEN, VIRTKEY
END
